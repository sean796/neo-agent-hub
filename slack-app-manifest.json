{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Neo Agent Hub",
    "description": "Agency agent hub: run meeting-notes and future agents from Slack.",
    "background_color": "#09090b"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Neo Agent Hub",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Write: correct",
        "type": "message",
        "callback_id": "proofread_message",
        "description": "Fix grammar and clarity in place (/write correct)"
      },
      {
        "name": "Write: polish",
        "type": "message",
        "callback_id": "polish_message",
        "description": "Polish tone in place (/write polish)"
      },
      {
        "name": "Write: shorten",
        "type": "message",
        "callback_id": "shorten_message",
        "description": "Tighter wording in place (/write shorten)"
      },
      {
        "name": "Write: adjust",
        "type": "message",
        "callback_id": "adjust_message",
        "description": "Pick a style and rewrite in place (/write)"
      }
    ],
    "slash_commands": [
      {
        "command": "/agent",
        "description": "List or run Neo Digital agents",
        "usage_hint": "[agent-id]",
        "should_escape": false,
        "url": "https://neo-agent-hub-api.onrender.com/slack/commands"
      },
      {
        "command": "/meeting-notes",
        "description": "Meeting notes to task list and checklist",
        "usage_hint": "[latest]",
        "should_escape": false,
        "url": "https://neo-agent-hub-api.onrender.com/slack/commands"
      },
      {
        "command": "/seo-pulse",
        "description": "GSC digest and one recommended action",
        "usage_hint": "[site-slug]",
        "should_escape": false,
        "url": "https://neo-agent-hub-api.onrender.com/slack/commands"
      },
      {
        "command": "/intent-check",
        "description": "Check draft vs search intent (beta)",
        "usage_hint": "query and outline or URL",
        "should_escape": false,
        "url": "https://neo-agent-hub-api.onrender.com/slack/commands"
      },
      {
        "command": "/write",
        "description": "AI rewrite a draft (correct, polish, shorten, and more)",
        "usage_hint": "[style] draft text, or leave empty for editor",
        "should_escape": false,
        "url": "https://neo-agent-hub-api.onrender.com/slack/commands"
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://neo-agent-hub-api.onrender.com/oauth/slack/callback"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "users:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ],
      "user": [
        "chat:write",
        "im:write",
        "mpim:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://neo-agent-hub-api.onrender.com/slack/events",
      "bot_events": ["app_home_opened"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://neo-agent-hub-api.onrender.com/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
